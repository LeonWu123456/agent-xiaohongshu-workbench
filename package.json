{
  "name": "xiaoshimei-studio",
  "version": "0.3.0",
  "description": "小师妹 Studio：本地优先的小红书图文创作工作台，支持直接 AI 图文生成、编辑、审稿与人工发布。",
  "license": "MIT",
  "author": "Xiaoshimei Studio contributors",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/share-site"
  ],
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test test/direct-ai.test.mjs test/account-workspace.test.mjs test/agent-runner.test.mjs test/output-archive.test.mjs test/render-cards.test.mjs test/viral-filter.test.mjs test/workspace-editor.test.mjs test/xhs-draft-verifier.test.mjs",
    "test:share": "npm --workspace @agent-xiaohongshu/share-site test",
    "test:all": "npm run test && npm run test:share",
    "build:share": "npm --workspace @agent-xiaohongshu/share-site run build",
    "setup": "node scripts/verify-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "make:desktop-icon": "node scripts/make-desktop-icon.mjs",
    "make:mac-icon": "node scripts/make-mac-icon.mjs",
    "package:win": "npm run build && npm run make:desktop-icon && electron-builder --win nsis --publish never",
    "package:mac:arm64": "npm run build && npm run make:mac-icon && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "@jackwener/opencli": "1.8.6",
    "@vitejs/plugin-react": "5.0.4",
    "express": "5.1.0",
    "openai": "7.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.4",
    "undici": "^6.27.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.mesy.xiaoshimei.studio",
    "productName": "小师妹 Studio",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "desktop/**/*",
      ".agents/**/*",
      "scripts/**/*",
      "public/project-logo.png",
      "package.json",
      "!**/.data{,/**}",
      "!**/output{,/**}",
      "!**/tmp{,/**}",
      "!public/generated{,/**}",
      "!public/brand{,/**}",
      "!test{,/**}",
      "!docs{,/**}",
      "!packages{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Xiaoshimei-Studio-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "Xiaoshimei-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小师妹 Studio"
    }
  }
}
